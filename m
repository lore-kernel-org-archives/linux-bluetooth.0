-static int report_cmp(gconstpointer a, gconstpointer b)
-{
-	const struct report *ra = a, *rb = b;
-
-	/* sort by type first.. */
-	if (ra->type != rb->type)
-		return ra->type - rb->type;
-
-	/* skip id check in case of reports not being numbered  */
-	if (!ra->numbered && !rb->numbered)
-		return 0;
-
-	/* ..then by id */
-	return ra->id - rb->id;
-}
