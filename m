-		break;
-	case HOG_REPORT_TYPE_OUTPUT:
-		if (hog->uhid_flags & UHID_DEV_NUMBERED_OUTPUT_REPORTS)
-			report->numbered = true;
-		break;
-	case HOG_REPORT_TYPE_FEATURE:
