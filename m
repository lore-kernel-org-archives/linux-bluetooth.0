   318		do {
   319			if ((offset >= fw->size) || (fw_data->last_ack))
   320				break;
   321			tx_len = fw_data->next_len;
   322			if ((fw->size - offset) < tx_len)
   323				tx_len = fw->size - offset;
   324	
   325			memcpy(skb->data, &fw->data[offset], tx_len);
