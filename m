-	vlen = dec_read_resp(pdu, plen, value, sizeof(value));
-	if (vlen < 0) {
-		DBG("Protocol error");
-		return;
-	}
-
-	if (vlen != 1) {
-		DBG("Invalid length for TX Power value: %zd", vlen);
-		return;
-	}
-
-	DBG("Tx Power Level: %02x", (int8_t) value[0]);
