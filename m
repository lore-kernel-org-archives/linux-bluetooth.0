#ifdef HAVE_CONFIG_H
#include <config.h>
#endif

#include <stdio.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <getopt.h>
#include <sys/stat.h>

#include "sbc.h"
#include "formats.h"

int verbose=3D0;

static ssize_t __read(int fd, void *buf, size_t count)
{
	ssize_t len, pos =3D 0;

	while (count > 0) {
		len =3D read(fd, buf + pos, count);
		if (len <=3D 0)
			return len;

		count -=3D len;
		pos   +=3D len;
	}

	return pos;
}

static ssize_t __write(int fd, const void *buf, size_t count)
{
	ssize_t len, pos =3D 0;

	while (count > 0) {
		len =3D write(fd, buf + pos, count);
		if (len <=3D 0)
			return len;

		count -=3D len;
		pos   +=3D len;
	}

	return pos;
}

static void encode(char *filename, int subbands, int bitpool, int joint, =
int SNR)
{
	struct au_header *au_hdr;
	unsigned char input[2048], output[2048];
	sbc_t sbc;
	int fd, len, size, count, encoded;

	if (strcmp(filename, "-")) {
		fd =3D open(filename, O_RDONLY);
		if (fd < 0) {
			fprintf(stderr, "Can't open file %s: %s\n",
						filename, strerror(errno));
			return;
		}
	} else
		fd =3D fileno(stdin);

	len =3D __read(fd, input, sizeof(input));
	if (len < sizeof(*au_hdr)) {
		if (fd > fileno(stderr))
			fprintf(stderr, "Can't read header from file %s: %s\n",
						filename, strerror(errno));
		else
			perror("Can't read audio header");
		goto done;
	}

	au_hdr =3D (struct au_header *) input;

	if (au_hdr->magic !=3D AU_MAGIC ||
			BE_INT(au_hdr->hdr_size) > 128 ||
			BE_INT(au_hdr->hdr_size) < 24 ||
			BE_INT(au_hdr->encoding) !=3D AU_FMT_LIN16) {
		fprintf(stderr, "Data is not in Sun/NeXT audio S16_BE format\n");
		goto done;
	}


	sbc_init(&sbc, 0L);

	switch (BE_INT(au_hdr->sample_rate)) {
	case 16000:
		sbc.frequency =3D SBC_FREQ_16000;
		break;
	case 32000:
		sbc.frequency =3D SBC_FREQ_32000;
		break;
	case 44100:
		sbc.frequency =3D SBC_FREQ_44100;
		break;
	case 48000:
		sbc.frequency =3D SBC_FREQ_48000;
		break;
	}
	int srate =3D BE_INT(au_hdr->sample_rate);

	sbc.subbands =3D subbands =3D=3D 4 ? SBC_SB_4 : SBC_SB_8;

	if (BE_INT(au_hdr->channels) =3D=3D 1)
		sbc.mode =3D SBC_MODE_MONO;
	else if (joint)
		sbc.mode =3D SBC_MODE_JOINT_STEREO;
	else
		sbc.mode =3D SBC_MODE_STEREO;

	sbc.endian =3D SBC_BE;
	count =3D BE_INT(au_hdr->data_size);
	size =3D len - BE_INT(au_hdr->hdr_size);
	memmove(input, input + BE_INT(au_hdr->hdr_size), size);

	sbc.bitpool =3D bitpool;
	sbc.allocation =3D SNR ? SBC_AM_SNR : SBC_AM_LOUDNESS;

	if(verbose) {
	  fprintf(stderr,"encoding %s with rate %d, %d subbands, %d bits, AM =
%s, and mode %s\n",
		  filename,srate,subbands,bitpool,
		  sbc.allocation=3D=3DSBC_AM_SNR?"SNR":"LOUDNESS",
		  =
sbc.mode=3D=3DSBC_MODE_MONO?"MONO":sbc.mode=3D=3DSBC_MODE_STEREO?"STEREO"=
:"JOINTSTEREO");
	}

	while (1) {
		if (size < sizeof(input)) {
			len =3D __read(fd, input + size, sizeof(input) - size);
			if (len =3D=3D 0 && size =3D=3D 0)
				break;

			if (len < 0) {
				perror("Can't read audio data");
				break;
			}

			size +=3D len;
		}

		len =3D sbc_encode(&sbc, input, size,
					output, sizeof(output), &encoded);
		if (len < size)
			memmove(input, input + len, size - len);

		size -=3D len;

		len =3D __write(fileno(stdout), output, encoded);
		if (len =3D=3D 0)
			break;

		if (len < 0 || len !=3D encoded) {
			perror("Can't write SBC output");
			break;
		}
	}

	sbc_finish(&sbc);

done:
	if (fd > fileno(stderr))
		close(fd);
}

static void usage(void)
{
	printf("SBC encoder utility ver %s\n", VERSION);
	printf("Copyright (c) 2004-2008  Marcel Holtmann\n\n");

	printf("Usage:\n"
		"\tsbcenc [options] file(s)\n"
		"\n");

	printf("Options:\n"
		"\t-h, --help           Display help\n"
		"\t-v, --verbose        Verbose mode\n"
		"\t-s, --subbands       Number of subbands to use (4 or 8)\n"
		"\t-b, --bitpool        Bitpool value (default is 32)\n"
		"\t-j, --joint          Joint stereo\n"
	        "\t-S, --SNR            Use SNR mode (default is loudness)\n"
		"\n");
}

static struct option main_options[] =3D {
	{ "help",	0, 0, 'h' },
	{ "verbose",	0, 0, 'v' },
	{ "subbands",	1, 0, 's' },
	{ "bitpool",	1, 0, 'b' },
	{ "joint",	0, 0, 'j' },
	{ "SNR",        0, 0, 'S' },
	{ 0, 0, 0, 0 }
};

int main(int argc, char *argv[])
{
  int i, opt, subbands =3D 8, bitpool =3D 32, joint =3D 0, SNR=3D0;

  while ((opt =3D getopt_long(argc, argv, "+hvs:b:jS", main_options, =
NULL)) !=3D -1) {
		switch(opt) {
		case 'h':
			usage();
			exit(0);

		case 'v':
			verbose =3D 1;
			break;

		case 's':
			subbands =3D atoi(optarg);
			if (subbands !=3D 8 && subbands !=3D 4) {
				fprintf(stderr, "Invalid subbands %d!\n",
						subbands);
				exit(1);
			}
			break;

		case 'b':
			bitpool =3D atoi(optarg);
			break;

		case 'j':
			joint =3D 1;
			break;

		case 'S':
		  SNR =3D 1;
		  break;

		default:
			exit(1);
		}
	}

	argc -=3D optind;
	argv +=3D optind;
	optind =3D 0;

	if (argc < 1) {
		usage();
		exit(1);
	}

	for (i =3D 0; i < argc; i++)
	  encode(argv[i], subbands, bitpool, joint, SNR);

	return 0;
}

