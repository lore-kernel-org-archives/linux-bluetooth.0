-	DBG("Link Loss: %s, Path Loss: %s, FindMe: %s",
-				monitor->enabled.linkloss ? "TRUE" : "FALSE",
-				monitor->enabled.pathloss ? "TRUE" : "FALSE",
-				monitor->enabled.findme ? "TRUE" : "FALSE");
