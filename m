-	}
-
-	if (!dec_write_resp(pdu, plen)) {
-		error("Link Loss Write Request: protocol error");
-		return;
-	}
-
-	DBG("Link Loss Alert Level written");
-
-	g_dbus_emit_property_changed(btd_get_dbus_connection(), path,
-				PROXIMITY_INTERFACE, "LinkLossAlertLevel");
